# 复制成 keystore.properties 并填上你自己的签名信息（这个文件不要提交到仓库）
#
# 生成密钥（只做一次，后面一直用同一个）：
#   keytool -genkeypair -v -keystore xiaodian.jks -alias xiaodian -keyalg RSA -keysize 2048 -validity 10000
#
# 没有这个文件时，release 会用 debug 签名，能装机但上不了应用商店。

storeFile=../xiaodian.jks
storePassword=改成你的密码
keyAlias=xiaodian
keyPassword=改成你的密码